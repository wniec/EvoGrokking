## Lines starting with a double hash are notes for whoever edits this template;
## write_config strips them, so they never reach the generated file.
##
## Edit fixed values here directly.  Anything that should be tunable per run
## needs a {braced_name} plus a matching keyword argument in write_config.
## This file is rendered with str.format, so a *literal* brace must be doubled.
# Generated by evogrokking from evogrokking/neat.config -- do not edit this copy;
# it is a record of the settings this particular run used.
# Classical NEAT: one node = one neuron, one connection = one scalar weight.
# Weights and biases are trained by gradient descent, not evolved, so their genes
# are pinned below.  The training recipe (lr, weight decay, dropout, optimizer,
# init scale) is fixed for the whole run, see evogrokking/hyperparams.py.
[NEAT]
fitness_criterion     = max
fitness_threshold     = 1e9
no_fitness_termination = True
pop_size              = {pop_size}
reset_on_extinction   = True

[ArchGenome]
# One neuron per input feature and one per class logit.
num_inputs            = {n_inputs}
num_outputs           = {n_outputs}
num_hidden            = {n_hidden}
feed_forward          = True
initial_connection    = {initial_connection}

# neat-python normalises distance by gene count, so this threshold is a *mean
# per-gene* difference, not a raw sum -- it is much smaller than textbook NEAT's.
compatibility_disjoint_coefficient = 1.0
compatibility_weight_coefficient   = 0.5

conn_add_prob         = {conn_add_prob}
conn_delete_prob      = {conn_delete_prob}
node_add_prob         = {node_add_prob}
node_delete_prob      = {node_delete_prob}
single_structural_mutation = False
structural_mutation_surer  = default
## Not a neat-python setting: evogrokking's ArchGenome.mutate repeats the four
## structural operators this many times per genome, so the mutation step scales
## with genome size instead of being fixed at one gene per generation.
structural_mutation_rounds = {structural_mutation_rounds}

# --- activation: the one real node gene ---
activation_default      = {activation_default}
activation_options      = {activations}
activation_mutate_rate  = {activation_mutate_rate}

# --- aggregation: neurons always sum their inputs ---
aggregation_default     = sum
aggregation_options     = sum
aggregation_mutate_rate = 0.0

# --- bias / response: unused. Every neuron owns a bias trained by gradient
# --- descent, so these genes are pinned to a constant.
bias_init_mean        = 0.0
bias_init_stdev       = 0.0
bias_max_value        = 0.0
bias_min_value        = 0.0
bias_mutate_power     = 0.0
bias_mutate_rate      = 0.0
bias_replace_rate     = 0.0

response_init_mean    = 1.0
response_init_stdev   = 0.0
response_max_value    = 1.0
response_min_value    = 1.0
response_mutate_power = 0.0
response_mutate_rate  = 0.0
response_replace_rate = 0.0

# --- connection weight: also unused (weights come from gradient descent), but
# --- neat-python's add-node mutation reads it, so it stays pinned at 1.
weight_init_mean      = 1.0
weight_init_stdev     = 0.0
weight_max_value      = 1.0
weight_min_value      = 1.0
weight_mutate_power   = 0.0
weight_mutate_rate    = 0.0
weight_replace_rate   = 0.0

enabled_default       = True
enabled_mutate_rate   = {enabled_mutate_rate}

[DefaultSpeciesSet]
compatibility_threshold = {compatibility_threshold}

[DefaultStagnation]
species_fitness_func = max
max_stagnation       = {max_stagnation}
species_elitism      = {species_elitism}

[DefaultReproduction]
elitism            = {elitism}
survival_threshold = {survival_threshold}
## min_species_size stays at 1: the diversity knobs (structural_mutation_rounds,
## partial initial connectivity, a low compatibility_threshold) can push the
## number of species close to pop_size, and neat-python raises a hard error when
## num_species * min_species_size exceeds pop_size.  With 1 that can never happen.
min_species_size   = 1
